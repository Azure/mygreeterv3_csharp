# (Prerequisite) To deploy the shared resources needed, go to the directory of the shared resources and run the Makefile.
CURRENT_DIR := $(shell pwd)

#Kube config must exist within server directory to be accessible in docker container when running helm commands
connect-cluster:
	az account set --subscription {{.subscriptionId}}
	az aks get-credentials --resource-group servicehub-{{.resourcesName}}-rg --name servicehub-{{.resourcesName}}-cluster --file $(CURRENT_DIR)/.kube/config
	if grep -qF -- "export KUBECONFIG=$(CURRENT_DIR)/.kube/config" ~/.bashrc; then \
		echo 'KUBECONFIG exists in ~/.bashrc'; \
	else \
		echo 'KUBECONFIG does not exist in ~/.bashrc'; \
		echo 'export KUBECONFIG=$(CURRENT_DIR)/.kube/config' >> ~/.bashrc; \
	fi

build-image:
	set -e; \
	docker build  \
	-t servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/mygreeterv3csharp -f ../Dockerfile ./../; \
	docker save -o mygreeterv3csharp-image.tar servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/mygreeterv3csharp; \

push-image:
	set -e; \
	az acr login --name servicehub{{.resourcesName}}{{.location}}acr.azurecr.io; \
	docker load -i mygreeterv3csharp-image.tar; \
	docker push servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/mygreeterv3csharp; \
	rm mygreeterv3csharp-image.tar;