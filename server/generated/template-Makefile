# (Prerequisite) To deploy the shared resources needed, go to the directory of the shared resources and run the Makefile.
SERVER_DIR := $(shell dirname -- $(shell pwd))

#Kube config must exist within server directory to be accessible in docker container when running helm commands
connect-cluster:
	az account set --subscription {{.subscriptionId}}
	az aks get-credentials --resource-group servicehub-{{.resourcesName}}-rg --name servicehub-{{.resourcesName}}-cluster --file $(SERVER_DIR)/.kube/config
	if grep -qF -- "export KUBECONFIG=$(SERVER_DIR)/.kube/config" ~/.bashrc; then \
		echo 'KUBECONFIG exists in ~/.bashrc'; \
	else \
		echo 'KUBECONFIG does not exist in ~/.bashrc'; \
		echo 'export KUBECONFIG=$(SERVER_DIR)/.kube/config' >> ~/.bashrc; \
	fi

build-image:
	set -e; \
	<<- if contains .envInformation.goModuleNamePrefix "dev.azure.com">>
	if [ -z "$(READ_PAT)" ]; then \
		echo "READ_PAT does not exist. Please rerun the command with this variable"; \
		exit 1; \
	fi; \
	docker build --build-arg PAT=$(READ_PAT) \
	-t servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/<<.serviceInput.directoryName>> -f ../Dockerfile ./../; \
	<<- else>>docker build --build-arg AKS_GOPROXY_TOKEN --build-arg GOPROXY --build-arg GOPRIVATE --build-arg GONOPROXY \
	-t servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/<<.serviceInput.directoryName>> -f ../Dockerfile ./../; \<<end>>
	docker save -o <<.serviceInput.directoryName>>-image.tar servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/<<.serviceInput.directoryName>>; \

push-image:
	set -e; \
	az acr login --name servicehub{{.resourcesName}}{{.location}}acr.azurecr.io; \
	docker load -i <<.serviceInput.directoryName>>-image.tar; \
	docker push servicehub{{.resourcesName}}{{.location}}acr.azurecr.io/<<.serviceInput.directoryName>>; \
	rm <<.serviceInput.directoryName>>-image.tar;